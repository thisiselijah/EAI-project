 class MemoryTrackerCPU(MemoryTracker):
     """
-    TO DO : Right now it's not usable, as we miss `maximum_value`
-    Would be nice to add, but not urgent
-    Could use:
-    https://docs.python.org/3/library/tracemalloc.html
+    CPU counterpart of MemoryTrackerCUDA.
+
+    PyTorch's CPU allocator has no `memory_allocated()` counter, and process
+    RSS is far too noisy (malloc caching, Python objects) to measure a single
+    operation. Instead, `measure` runs the function under the PyTorch profiler
+    with `profile_memory=True`, which reports every allocation and free made
+    by the CPU allocator. Summing those events gives the net allocated bytes
+    (`usage`) and the running maximum gives the peak (`max_usage`), i.e. the
+    same quantities MemoryTrackerCUDA obtains from the CUDA allocator.
+
+    Allocations made outside `measure` are not tracked, so `current()` and
+    `maximum()` are only meaningful relative to one another inside `measure`.
     """
     def __init__(self):
-        self.process = psutil.Process(os.getpid())
+        self.allocated = 0
         self.max_memory = 0
         super().__init__(torch.device("cpu"))
     def maximum(self):
         return self.max_memory
     def current(self):
-        result = int(self.process.memory_info().rss)
-        self.max_memory = max(self.max_memory, result)
-        return result
+        return self.allocated
     def reset_max(self):
-        self.max_memory = 0
-        self.max_memory = self.current()
-    
+        self.max_memory = self.allocated
+
+    def measure(self, func, *args):
+        from torch.profiler import profile, ProfilerActivity
+        with profile(activities=[ProfilerActivity.CPU], profile_memory=True) as prof:
+            result = func(*args)
+        events = sorted(
+            (e.start_ns(), e.nbytes())
+            for e in prof.profiler.kineto_results.events()
+            if e.name() == "[memory]"
+        )
+        current = peak = 0
+        for _, nbytes in events:
+            current += nbytes
+            peak = max(peak, current)
+        self.allocated += current
+        self.max_memory = max(self.max_memory, self.allocated)
+        self.last_memory = self.allocated
+        return result, current, peak
+
+
+def get_MemoryTracker(device):
+    if "cuda" in str(device): return MemoryTrackerCUDA(device)
+    else: return MemoryTrackerCPU()
+
     
 class MemoryTrackerCUDA(MemoryTracker):
     def maximum(self):
