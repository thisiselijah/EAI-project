+def _optimizer_state_size(optimizer):
+    return sum(
+        v.numel() * v.element_size()
+        for state in optimizer.state.values()
+        for v in state.values()
+        if isinstance(v, torch.Tensor) and v.dim() > 0
+    )
+
+
+def get_optimize_metrics_cpu(
+    _p, optim, cpu_optim=None, optim_kwargs={}, niter=20, size=1024**2
+):
+    """
+    CPU-only version of get_optimize_metrics: the "gpu" optimizer runs on the
+    CPU as well, and the optimizer state size is read from the optimizer state
+    instead of the CUDA allocator.
+    """
+    if cpu_optim is None:
+        cpu_optim = optim
+    timer = TimerCPU()
+    p = torch.nn.Parameter(torch.zeros(size, dtype=_p.dtype))
+    p.grad = torch.ones_like(p)
+    optimizer = optim([p], **optim_kwargs)
+    optimizer.step()  # creates the states
+    timer.start()
+    for _ in range(niter):
+        optimizer.step()
+    timer.end()
+    speed = size * p.element_size() * niter / timer.elapsed()
+    opt_size = _optimizer_state_size(optimizer)
+    return {
+        "cpu_optimize_speed": speed * 0.8,
+        "gpu_optimize_speed": speed,
+        "optimizer_states_factor": round(opt_size // size / p.element_size()),
+        "optimizer_overhead": 0,
+        "cpu_optim": cpu_optim,
+        "gpu_optim": optim,
+        "optim_kwargs": optim_kwargs,
+    }
+
+
 def get_optimize_metrics(
