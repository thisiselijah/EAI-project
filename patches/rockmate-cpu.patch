+"""
+Rockmate on CPU (no CUDA): correctness and memory checks.
+
+Run with:  python -m pytest rockmate/test/test_cpu.py -s
+"""
+import copy
+
+import pytest
+import torch
+import torch.nn as nn
+
+from rkgb.lowlevel.measure import MemoryTrackerCPU
+from rockmate import PureRockmate, PureRotor
+
+MiB = 1024**2
+
+
+class Block(nn.Module):
+    """Pre-norm transformer block (same layout as DeiT / AutoFormer)."""
+
+    def __init__(self, dim, heads, mlp_ratio=4):
+        super().__init__()
+        self.heads = heads
+        self.norm1 = nn.LayerNorm(dim)
+        self.qkv = nn.Linear(dim, 3 * dim)
+        self.proj = nn.Linear(dim, dim)
+        self.norm2 = nn.LayerNorm(dim)
+        self.fc1 = nn.Linear(dim, mlp_ratio * dim)
+        self.act = nn.GELU()
+        self.fc2 = nn.Linear(mlp_ratio * dim, dim)
+
+    def forward(self, x):
+        B, N, C = x.shape
+        h = self.heads
+        qkv = self.qkv(self.norm1(x)).reshape(B, N, 3, h, C // h).permute(2, 0, 3, 1, 4)
+        q, k, v = qkv[0], qkv[1], qkv[2]
+        attn = (q @ k.transpose(-2, -1)) * (C // h) ** -0.5
+        attn = attn.softmax(dim=-1)
+        y = (attn @ v).transpose(1, 2).reshape(B, N, C)
+        x = x + self.proj(y)
+        x = x + self.fc2(self.act(self.fc1(self.norm2(x))))
+        return x
+
+
+class Head(nn.Module):
+    """Trainable top of the network in latent replay: blocks + norm + classifier."""
+
+    def __init__(self, depth=4, dim=192, heads=3, classes=50):
+        super().__init__()
+        self.blocks = nn.Sequential(*[Block(dim, heads) for _ in range(depth)])
+        self.norm = nn.LayerNorm(dim)
+        self.fc = nn.Linear(dim, classes)
+
+    def forward(self, z):
+        z = self.norm(self.blocks(z))
+        return self.fc(z.mean(dim=1))
+
+
+def make_model_and_input(batch=32, tokens=65, dim=192):
+    torch.manual_seed(0)
+    model = Head(dim=dim)
+    x = torch.randn(batch, tokens, dim)
+    return model, x
+
+
+def train_step(model, x):
+    y = model(x)
+    if isinstance(y, tuple):
+        y = y[0]
+    loss = y.square().mean()
+    loss.backward()
+    return loss
+
+
+def peak_of(func, *args):
+    _, _, peak = MemoryTrackerCPU().measure(func, *args)
+    return peak
+
+
+def test_memory_tracker_cpu():
+    a = torch.randn(512, 512)  # 1 MiB
+
+    def f():
+        b = a @ a  # 1 MiB, kept
+        c = torch.relu(b)  # 1 MiB, freed
+        del c
+        return b
+
+    _, usage, peak = MemoryTrackerCPU().measure(f)
+    assert usage == pytest.approx(1 * MiB, rel=0.01)
+    assert peak == pytest.approx(2 * MiB, rel=0.01)
+
+
+@pytest.mark.parametrize(
+    "rk_class,budget_ratio",
+    [(PureRockmate, 1.0), (PureRockmate, 0.5), (PureRotor, 0.5)],
+)
+def test_gradients_match_pytorch(rk_class, budget_ratio):
+    model, x = make_model_and_input()
+    ref = copy.deepcopy(model)
+    act_peak = peak_of(train_step, copy.deepcopy(model), x)
+
+    rk = rk_class(model, [x], budget=act_peak * budget_ratio, device="cpu")
+    for _ in range(2):  # 1st call runs the init path, 2nd the steady state
+        rk.zero_grad()
+        ref.zero_grad()
+        loss_rk = train_step(rk, x)
+        loss_ref = train_step(ref, x)
+        assert torch.allclose(loss_rk, loss_ref, rtol=1e-5, atol=1e-6)
+        for (name, p_rk), (_, p_ref) in zip(
+            model.named_parameters(), ref.named_parameters()
+        ):
+            assert p_rk.grad is not None, name
+            assert torch.allclose(p_rk.grad, p_ref.grad, rtol=1e-4, atol=1e-6), name
+
+
+def test_peak_memory_below_budget():
+    model, x = make_model_and_input(batch=64)
+    pt_peak = peak_of(train_step, copy.deepcopy(model), x)
+    budget = 0.5 * pt_peak
+    rk = PureRockmate(model, [x], budget=budget, device="cpu")
+    train_step(rk, x)  # warm-up: init path allocates placeholders
+    rk.zero_grad()
+    rk_peak = peak_of(train_step, rk, x)
+    print(
+        f"\nPyTorch peak {pt_peak / MiB:.1f} MiB | budget {budget / MiB:.1f} MiB | "
+        f"Rockmate simulated {rk.op_sched.peak_mem / MiB:.1f} MiB | "
+        f"Rockmate measured {rk_peak / MiB:.1f} MiB"
+    )
+    assert rk_peak < pt_peak
+    # small tolerance: gradients of parameters are allocated by autograd
+    assert rk_peak <= budget * 1.10
