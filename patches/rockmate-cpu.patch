diff --git a/rkgb/src/rkgb/lowlevel/device.py b/rkgb/src/rkgb/lowlevel/device.py
new file mode 100644
index 0000000..1b4a33b
--- /dev/null
+++ b/rkgb/src/rkgb/lowlevel/device.py
@@ -0,0 +1,96 @@
+"""
+Device helpers so that rkgb / rockmate can run on CPU-only machines
+(e.g. Raspberry Pi, macOS) as well as on CUDA GPUs.
+
+On CUDA every helper forwards to the corresponding `torch.cuda` call.
+On CPU, streams and events become no-op placeholders: CPU execution
+is synchronous, so there is nothing to wait for.
+"""
+import contextlib
+import torch
+
+
+def as_device(device):
+    if device is None:
+        return default_device()
+    return torch.device(device)
+
+
+def default_device():
+    """CUDA when available, otherwise CPU (keeps the old default on GPU machines)."""
+    return torch.device("cuda" if torch.cuda.is_available() else "cpu")
+
+
+def is_cuda(device):
+    return as_device(device).type == "cuda"
+
+
+def synchronize(device=None):
+    if is_cuda(device):
+        torch.cuda.synchronize(as_device(device))
+
+
+def pin_memory_available():
+    """Pinned host memory needs a CUDA runtime; on CPU-only builds it raises."""
+    return torch.cuda.is_available()
+
+
+class NullStream:
+    """Stands in for torch.cuda.Stream on CPU."""
+
+    def synchronize(self):
+        pass
+
+    def wait_event(self, event):
+        pass
+
+    def wait_stream(self, stream):
+        pass
+
+    def query(self):
+        return True
+
+
+class NullEvent:
+    """Stands in for torch.cuda.Event on CPU."""
+
+    def record(self, stream=None):
+        pass
+
+    def wait(self, stream=None):
+        pass
+
+    def synchronize(self):
+        pass
+
+    def query(self):
+        return True
+
+
+def current_stream(device):
+    if is_cuda(device):
+        return torch.cuda.current_stream(as_device(device))
+    return NullStream()
+
+
+def new_stream(device):
+    if is_cuda(device):
+        return torch.cuda.Stream(as_device(device))
+    return NullStream()
+
+
+def stream_context(stream):
+    if isinstance(stream, NullStream):
+        return contextlib.nullcontext()
+    return torch.cuda.stream(stream)
+
+
+def stream_synchronize(stream):
+    stream.synchronize()
+
+
+def new_event(stream):
+    """Create an event on the same kind of device as `stream`."""
+    if isinstance(stream, NullStream):
+        return NullEvent()
+    return torch.cuda.Event()
